
/**
 * This ruleset enforces a strict user-ownership security model for the MiniBarnMaster application.
 * Updated to explicitly permit public read access for testimonials, gallery, and site configuration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
