{
  "entities": {
    "Customer": {
      "title": "Customer",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email"
      ]
    },
    "ConsultationRequest": {
      "title": "ConsultationRequest",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "requestDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "customerId",
        "name",
        "email",
        "status"
      ]
    },
    "Testimonial": {
      "title": "Testimonial",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "category": {
          "type": "string",
          "description": "e.g., Fine Art, Photography, Exhibition"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "author",
        "text",
        "rating",
        "status"
      ]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hoverText": {
          "type": "string"
        },
        "album": {
          "type": "string"
        },
        "subAlbum": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "uploadDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "imageUrl",
        "description"
      ]
    },
    "AppConfig": {
      "title": "AppConfig",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string"
        },
        "testimonialsEnabled": {
          "type": "boolean"
        },
        "watermarkEnabled": {
          "type": "boolean"
        },
        "watermarkText": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "lastUpdated"
      ]
    },
    "ArtWishlist": {
      "title": "ArtWishlist",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "itemId": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/allConsultationRequests/{requestId}",
        "definition": {
          "entityName": "ConsultationRequest"
        }
      },
      {
        "path": "/allTestimonials/{testimonialId}",
        "definition": {
          "entityName": "Testimonial"
        }
      },
      {
        "path": "/gallery/{imageId}",
        "definition": {
          "entityName": "GalleryItem"
        }
      },
      {
        "path": "/appConfig/{configId}",
        "definition": {
          "entityName": "AppConfig"
        }
      },
      {
        "path": "/customers/{userId}/wishlist/{wishlistId}",
        "definition": {
          "entityName": "ArtWishlist"
        }
      }
    ]
  }
}