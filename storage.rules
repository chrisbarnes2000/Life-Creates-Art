rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email.lower() == 'chris.barnes.2000@me.com' ||
        request.auth.token.email == 'Chris.Barnes.2000@me.com' ||
        request.auth.token.admin == true
      );
    }
  }
}
